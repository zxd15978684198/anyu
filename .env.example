# ============================================================================
# 安语（Anyu）环境变量样例
# ----------------------------------------------------------------------------
# 用法：
#   cp .env.example .env     然后只在 .env 里填真实值
# 铁律：
#   1. .env 已在 .gitignore，永不入库；本文件只放占位符，任何真实 key 都不许写进来
#   2. 代码里禁止 os.environ.get 散读，统一走 app/core 的 Pydantic Settings
#   3. 密钥不得写进 prompt、测试夹具、日志、提交信息
#   4. 变量名与端口为本项目自定义口径（PRD/技术文档/迭代排期均未定义），新增请同步 README §6
# ============================================================================

# ---------------------------- 应用 ----------------------------
APP_NAME=anyu
APP_ENV=local                      # local | staging | prod
DEBUG=true
API_HOST=0.0.0.0
API_PORT=8000
PUBLIC_BASE_URL=https://localhost  # 对外访问根地址，用于生成媒体与回调 URL
FRONTEND_ORIGIN=https://localhost:5173   # CORS 白名单，多个用英文逗号分隔
LOG_LEVEL=INFO

# ---------------------------- 鉴权 / JWT ----------------------------
# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-random-48-bytes-00000000000000000000
ACCESS_TOKEN_EXPIRE_MINUTES=120    # 工作人员/家属 Access Token 2h
REFRESH_TOKEN_EXPIRE_DAYS=7        # Refresh Token 7d
ELDER_SESSION_EXPIRE_HOURS=24      # 模拟设备凭证换取的会话 24h，解绑即失效

# ---------------------------- 数据库（业务表） ----------------------------
# docker compose 宿主端口映射（默认 5432/6379，与 README §6 端口约定一致）；
# 仅当本机这两个端口被其他项目占用时才改，改完 DATABASE_URL / REDIS_URL 的端口要跟着改
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
DATABASE_URL=postgresql+asyncpg://anyu:anyu@localhost:5432/anyu  # pragma: allowlist secret
DATABASE_POOL_SIZE=10
DATABASE_POOL_MAX_OVERFLOW=20

# ---------------------------- LangGraph Checkpoint（独立 schema + 独立连接池） ----------------------------
# 与业务表同实例、不同 schema，物理隔离；不要复用业务连接池
LANGGRAPH_CHECKPOINT_DATABASE_URL=postgresql://anyu:anyu@localhost:5432/anyu  # pragma: allowlist secret
LANGGRAPH_CHECKPOINT_SCHEMA=langgraph
LANGGRAPH_CHECKPOINT_POOL_MIN_SIZE=1
LANGGRAPH_CHECKPOINT_POOL_MAX_SIZE=5

# ---------------------------- 缓存 / 限流 ----------------------------
REDIS_URL=redis://localhost:6379/0

# ---- Celery（迭代 10 离线批处理：日报/通知/离线扫描/音频清理；worker 与 beat 是独立进程） ----
# 总开关。false = backend 只跑 APScheduler，与迁移前行为一致（批 0 起默认关）
# 起 celery profile 前必须改 true（worker/beat 会在 false 时拒绝启动）：
CELERY_ENABLED=false
# broker 用独立 db /1：业务短期记忆仍在上面 REDIS_URL 的 /0，混用会让 FLUSHDB 与
# maxmemory 淘汰互相干扰。刻意不配 result_backend（这批任务没有返回值语义）
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
REDIS_KEY_PREFIX=anyu
RATE_LIMIT_PER_MINUTE=60

# ---------------------------- System Two · 大模型（DeepSeek / Qwen 兼容 API） ----------------------------
# 前五项留空 = 回落到 config.py 的默认值（provider=deepseek / base_url=https://api.deepseek.com/v1 /
# model=deepseek-chat / timeout=20s）；接真实供应商时再填。
LLM_PROVIDER=
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.6
# 额外请求头（JSON）。留空 = 不额外发头；示例：{"x-opencode-session":"anyu-app"}
LLM_EXTRA_HEADERS={"x-opencode-session":"anyu-app"}

# ---------------------------- System One · Laya（本地 CPU 意图分类） ----------------------------
LAYA_ENABLED=true
LAYA_BASE_URL=http://localhost:7001
LAYA_API_KEY=
LAYA_TIMEOUT_MS=200                # 单句分类预算 ≤200ms
LAYA_CONFIDENCE_THRESHOLD=0.85     # ≥0.85 直接路由，<0.85 只澄清一次
LAYA_FALLBACK_TO_LLM=true          # 加载失败时全部走 System Two

# ---------------------------- 语音识别 ASR（第三方流式，统一提供 key） ----------------------------
ASR_PROVIDER=
ASR_BASE_URL=
ASR_APP_ID=
ASR_API_KEY=
ASR_LANGUAGE=zh-CN
ASR_TIMEOUT_MS=300                 # 首包预算
ASR_EMIT_CONFIDENCE=true           # 置信度埋点开关，评测归因依赖它
ASR_INSECURE=false                 # FunASR 镜像自带自签证书；本地连 wss://<funasr>:10095 时置 true，生产换真证书后必须关

# ---------------------------- 语音合成 TTS（第三方流式） ----------------------------
TTS_PROVIDER=
TTS_BASE_URL=
TTS_APP_ID=
TTS_API_KEY=
TTS_VOICE_ID=                    # 例：zh-CN-XiaoxiaoNeural（温女声，长辈陪伴默认）
TTS_SPEED=1.0
TTS_TIMEOUT_MS=300                 # 首包预算；首包延迟是链路最大风险点
ALLOW_ROBOT_VOICE=false            # false：espeak 机器人声不进用户可播路径；断网宁字幕不落机器音
VOICE_PACK_ENABLED=true            # 固定话术音频包（scripts/bake_voice_pack.py 生成）
VOICE_PACK_DIR=static/voices       # 容器内 /app/static/voices，nginx 直出 /static/voices

# ---------------------------- 语音三档首包超时（技术设计文档 line 1042） ----------------------------
# 与上面的 ASR/TTS_TIMEOUT_MS（单次云调用建连预算）不同：这三项是「第一包多久算超时」，
# 由 app/core/timeouts.py::with_timeout 消费，超时一律降级不抛异常。
ASR_FIRST_PACKET_TIMEOUT_MS=2000
# 2026-11-12 实测：deepseek 首包 3.0~3.3s。设 3000 会让**每一轮**都判 llm_unavailable
# 走降级话术（对话里听不到模型说话）；云 API 接真模型时给到 15000。
LLM_FIRST_TOKEN_TIMEOUT_MS=15000
TTS_FIRST_PACKET_TIMEOUT_MS=1000

# ---------------------------- WebRTC / TURN ----------------------------
STUN_URL=stun:localhost:3478
TURN_URL=turn:localhost:3478
TURN_USERNAME=anyu
TURN_CREDENTIAL=replace-with-turn-password
TURN_CREDENTIAL_TTL_SECONDS=3600
TURN_PORT=3478                     # coturn --listening-port；STUN/TURN 共用，下发给浏览器时拼进 URL
TURN_TLS_PORT=5349                # coturn --tls-listening-port；下发 turns:<host>:5349?transport=tcp，置 0 = 不下发
# coturn 对外宣告的宿主机地址：本机填宿主机局域网 IP（如 192.168.1.50），
# 服务器填公网 IP（如 203.0.113.10）。留空 = 不传 --external-ip（同网段直连够用）。
# 填错的后果：relay 候选播的是错地址，ICE 卡在 checking —— 先在 chrome://webrtc-internals 看
# 有没有 srflx/relay 候选再怀疑这里。
TURN_EXTERNAL_IP=
WEBRTC_ICE_TIMEOUT_SECONDS=5       # 超时即降级为按住说话
WEBRTC_AUDIO_BITRATE_KBPS=32
WEBRTC_VAD_AGGRESSIVENESS=2        # webrtcvad 0-3

# ---------------------------- 本机演示（生产环境一律不生效） ----------------------------
# 长者端登录页「填入演示账号」按钮读这两项（GET /api/pad/demo-login）。
# 留空 = 按钮不出现；app_env=production 时即使填了也 404。
# 值要与 scripts/seed_demo.py 种进 devices 表的那台设备一致（密钥只存 sha256，改这里不会改库）。
DEMO_DEVICE_ID=
DEMO_DEVICE_SECRET=

# ---------------------------- 天气（全系统唯一真实外部接口） ----------------------------
WEATHER_API_PROVIDER=
WEATHER_API_BASE_URL=
WEATHER_API_KEY=
WEATHER_CACHE_TTL_SECONDS=600
WEATHER_DEFAULT_CITY=

# ---------------------------- 通知（仅 inapp / webpush，无微信、无邮件） ----------------------------
NOTIFY_CHANNEL=inapp               # inapp | webpush
WEBPUSH_VAPID_PUBLIC_KEY=
WEBPUSH_VAPID_PRIVATE_KEY=
WEBPUSH_SUBJECT=mailto:admin@example.com
NOTIFY_RETRY_INTERVAL_SECONDS=30
NOTIFY_MAX_RETRIES=3

# ---------------------------- MCP 客户端 ----------------------------
# 末尾的 `/mcp` 不能省：它是 MCP 协议面（streamable-http），`/health` 才是探活。
# 少了 `/mcp` 时客户端打到站点根路径，服务端只绑 `/mcp` → 工具层永远 unreachable
# （2026-11-12 实测：weather 少后缀时一次都没调通过）。
MCP_WEATHER_SERVER_URL=http://localhost:7101/mcp
MCP_OPERATIONS_SERVER_URL=http://localhost:7102/mcp
MCP_CALL_TIMEOUT_SECONDS=5
MCP_ENABLE_AUDIT=true              # 越权调用必须落 audit_logs

# ---------------------------- 观测（Langfuse + OpenTelemetry + /metrics） ----------------------------
# 填好下面两把 key 之后把开关置 true 才会真的上报；保持 false 是**零开销**（无 exporter、
# 无队列、无后台任务）。2026-11-12 已用 Langfuse Cloud 实例端到端验证通过
# （验收报告 §4.8：agent 根 span + tool span + 父子链）。
LANGFUSE_ENABLED=false
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_SAMPLE_RATE=1.0
OTEL_ENABLED=true
# OTLP **/HTTP** 端点（默认 4318）。填 4317（gRPC 端口）时 HTTP 导出器每次导出都失败降级
# —— 要嘛换 4318，要嘛真起 HTTP 接收端。
# Grafana Cloud：端点形如 https://otlp-gateway-<REGION>.grafana.net/otlp（SDK 自动追加
# /v1/traces、/v1/metrics），凭据从「OpenTelemetry setup → View connection details」的
# 「Create token」拿，拼成 Basic base64(<instance_id>:<token>) 填到下面 HEADERS。
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# 例：OTEL_EXPORTER_OTLP_HEADERS="Authorization=Basic%20MTkyMDY1MDpnbGNf..."（无凭据留空）
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SAMPLE_RATE=1.0               # trace 采样率；与 LANGFUSE_SAMPLE_RATE 相互独立
OTEL_SERVICE_NAME=anyu-backend
METRICS_ENABLED=true

# ---------------------------- 数据保留 / 调度 ----------------------------
AUDIO_RETENTION_HOURS=72           # 原始音频最长保留 72 小时，定时任务清理
AUDIO_DEBUG_SAVE=false             # 调试临时保存，禁止在生产打开
SCHEDULER_TIMEZONE=Asia/Shanghai
HEALTH_CHECKUP_START=19:00         # 健康采集窗口起点
HEALTH_CHECKUP_END=20:00           # 到点强制结束
DAILY_REPORT_GENERATE_HOUR=07:00   # 每天该小时生成家属日报
SCHEDULER_ENABLED=true             # uvicorn --reload 下自动禁用，避免双进程重复调度

# ---------------------------- 业务阈值（改动需评审，见 AGENTS.md §7） ----------------------------
MAX_TOOL_CALLS_PER_TURN=8
TOOL_REPEAT_WINDOW_SECONDS=60
TOOL_REPEAT_BREAK_THRESHOLD=3
MEDICATION_REMINDER_ATTEMPTS=4     # T0 / +5 / +10 / +15
MEDICATION_ATTEMPT_WAIT_SECONDS=60
VOICEPRINT_SIMILARITY_THRESHOLD=0.55  # CAM++ 原生口径（2026-11-09 产品负责人裁决由 0.85 下调，见 PRD v2.8）
# 声纹推理容器（迭代 4 · A1）：主服务不装 torch，重依赖隔离在容器里
VOICEPRINT_BASE_URL=http://localhost:7003
VOICEPRINT_EXTRACT_TIMEOUT_SECONDS=5.0
VOICEPRINT_EMBEDDING_DIMENSION=192    # CAM++ 固定 192 维
# 声纹 embedding 加密密钥：必须 32 字节 url-safe base64（否则声纹注册 500、比对降级）。
# 生产必须替换；开发留空则用 config.py 的本地默认 key（换 key 会使已落库密文无法解密）。
# 生成：uv run python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
# VOICEPRINT_FERNET_KEY=

# ---------------------------- 前端（无构建期变量） ----------------------------
# 前端一律同源访问 `/api`、`/ws`、`/media`（开发走 frontend/vite.config.ts 的 proxy，
# 生产走 nginx 的 location），代码里零 `import.meta.env.VITE_*` 读取。
# 历史上那 5 个 VITE_ 变量（VITE_API_BASE_URL / VITE_WS_BASE_URL / VITE_ENABLE_3D /
# VITE_ENABLE_WEBRTC / VITE_MEDIA_BASE_URL）从来没有被读取过，2026-11-13 已删除：
# 填了也不会生效，改后端地址请改 nginx 反代或 `FRONTEND_ORIGIN`。
# 3D 的静态头像兜底是代码逻辑（avatar-config.fallback_image_url → 仓库内置剪影），
# 不是构建开关。

# ---------------------------- 3D 数字人资产（迭代 4 · A3） ----------------------------
# 相对路径（/avatars/xxx.vrm）或绝对 URL；留空则走下一层兜底（前端内置资源）
DEFAULT_AVATAR_URL=
DEFAULT_FALLBACK_AVATAR_URL=
# 仅 VRM0 需要 π 补偿；VRM1 保持 0.0
AVATAR_ROTATION_Y_OFFSET=0.0
# 想让前端强制刷新形象缓存时改这个值（响应里的 version 由它参与计算）
AVATAR_CACHE_VERSION_SALT=
# ---------------------------- Embedding · 长期记忆向量（迭代 7 · W1） ----------------------------
# 三项（URL / MODEL / API_KEY）全空 → 自动降级为确定性向量：本地能跑通全部用例，
# 但向量是哈希噪声，只适合联调与自测，不能用来评估召回质量。
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
EMBEDDING_TIMEOUT_MS=5000

# ============================================================================
# 12. 2026-11-13 按代码字段补齐（原模板漏掉的 Settings 项 / 部署覆盖层变量）
#     取值说明见 app/core/config.py 的同名属性；标了「生产必须改」的那几行别原样上线。
# ============================================================================

# --- 请求层限流（app/core/rate_limit.py，攻防计划 §4.6 S3）---
RATE_LIMIT_ENABLED=true            # 总开关；生产关掉等于裸奔
RATE_LIMIT_ENFORCE_IN_DEV=false    # local/dev 默认不拦（否则单测互踩）；staging/prod 恒拦
# 后端在 nginx 后面时：不信任 X-Forwarded-For 会把全站算成同一个 IP（限流误伤）。
RATE_LIMIT_TRUST_FORWARDED_FOR=false
# JSON 数组；只信这些代理网段（docker 默认 172.16.0.0/12）。
RATE_LIMIT_TRUSTED_PROXIES=[]

# --- 身份与语音 ---
IDENTITY_REUSE_WINDOW_SECONDS=1800  # 同一 identity 复用/免问的窗口（秒）
WEBRTC_ICE_GRACE_SECONDS=10         # ICE 宽限：短暂抖动不算掉线
# 容器出网受限时走宿主机 scripts/tts_bridge.py，形如 http://host.docker.internal:7103
TTS_BRIDGE_URL=

# --- 知识层与向量 ---
KNOWLEDGE_OUTPUT_GUARD_ENABLED=true # 回答里出现来源/日期冲突时拦截或改写
EMBEDDING_DIMENSION=1024            # 必须与 EMBEDDING_MODEL 的实际维度一致

# --- 声纹加密（生产必须改）---
# 不设 = 用代码内置 dev key；app_env=production 时**直接启动失败**（刻意的）。
# 生成：python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
# VOICEPRINT_FERNET_KEY=

# --- 部署覆盖层 docker-compose.prod.yml 用到的变量（生产必须改口令）---
POSTGRES_USER=anyu
POSTGRES_DB=anyu
# 换成强口令；改口令要同步 ALTER USER，否则已初始化的数据卷连不上。
POSTGRES_PASSWORD=anyu
# frontend 证书目录；生产指向 /etc/letsencrypt/live/<域名>（见 docs/deploy/公网部署.md §6）
CERTS_DIR=./certs

# ============================================================================
# 13. compose 部署旋钮（docker-compose.yml / docker-compose.prod.yml 读，不是后端配置）
#     全部带默认值，不填也能 `docker compose up`；只有换镜像、改端口、换证书文件名时才碰。
#     与第 12 节的分界：第 12 节是 `app/core/config.py` 读的进程配置，这里是 compose 读的。
# ============================================================================

# --- 镜像（自建或换源；默认都指向本地 build 或官方 tag）---
# BACKEND_IMAGE=anyu-backend:local
# NGINX_IMAGE=nginx:1.27-alpine
# COTURN_IMAGE=coturn/coturn:4.6.2
# LAYA_IMAGE=anyu-laya:local          # Laya 本地权重镜像（System One）
# LAYA_MODEL_DIR=./models/laya              # 挂进容器的权重目录
# LAYA_PIP_INDEX_URL=                        # 容器内装依赖走哪个源，空则用默认

# --- 宿主端口（默认 8000/80/443/5173/5432/6379/7001/7002/7003/7101/7102）---
# BACKEND_HOST_PORT=8000
# FRONTEND_HTTP_PORT=80
# FRONTEND_HTTPS_PORT=443
# POSTGRES_HOST_PORT=5432
# REDIS_HOST_PORT=6379
# LAYA_HOST_PORT=7001
# FUNASR_HOST_PORT=7002
# VOICEPRINT_HOST_PORT=7003
# WEATHER_MCP_HOST_PORT=7101
# MOCK_OPERATIONS_MCP_HOST_PORT=7102

# --- nginx / 证书 ---
# NGINX_CONF_PATH=./frontend/nginx.https.conf   # 换成 nginx.conf 即走 HTTP-only（本机调试用）
# 证书目录与文件名：生产把 LE 的 fullchain.pem/privkey.pem 软链成 dev.crt/dev.key 即可
# 不动 nginx 配置（见 docs/deploy/公网部署.md §6），或直接改这两个文件名变量。
# TURN_CERT_FILE=dev.crt
# TURN_KEY_FILE=dev.key

# --- TURN / 演示设备 / 其他 ---
# TURN_REALM=anyu
# TURN_USERNAME=anyu
# TURN_TLS_PORT=5349
# DEMO_DEVICE_ID=device-001
# DEMO_DEVICE_SECRET=change-me            # 演示设备凭证，公网必须改
# MEDIA_DIR=./media                       # nginx 直出的媒体根
# HOSTNAME=anyu-backend             # 只在个别环境需要固定容器主机名
